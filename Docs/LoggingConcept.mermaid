flowchart TD
    %% Application Layer
    subgraph App["Application Layer"]
        A[User Request] -->|"Inbound Request"| B[API Gateway]
        B -->|"Forward to Backend"| C[Backend Services]
    end

    %% Telemetry Layer
    subgraph Telemetry["Telemetry Layer"]
        C -->|"Trace + Metrics + Logs"| T1[Telemetry SDKs]
        T1 -->|"Emit Logs"| SL[Structured Logs]
        T1 -->|"Emit Metrics & Traces"| MT[Metrics & Traces]
    end

    %% Sensitive Data Handling
    subgraph Sensitivity["Sensitive Data Handling"]
        SL -->|"Apply Rules"| MASK[Redaction & Masking]
    end

    %% Logging Path
    subgraph Log["Logging"]
        MASK -->|"Enrich with Metadata"| META[Metadata Injection]
        META -->|"Forward Logs"| LA[Log Aggregator]
        LA -->|"Route/Buffer"| LP[Log Processor]

        LP -->|"Store Logs"| ES[Elasticsearch]
        LP -->|"Store Logs"| COS[Cosmos DB]
        LP -->|"Send to"| APPINS[App Insights]
        LP -->|"Write File"| FS[Local Files]
        LP -->|"Stream to"| KAFKA[Kafka]
        LP -->|"Send to"| SPLUNK[Splunk]
        LP -->|"Send to"| DD_LOGS[Datadog Logs]
    end

    %% Datadog Agent
    subgraph Agent["Datadog Agent"]
        DA[Datadog Agent] --> DD_LOGS
        DA --> DD_METRICS[Datadog Metrics]
        DA --> DD_APM[Datadog Traces]
    end

    %% Monitoring
    subgraph Mon["Monitoring"]
        MT -->|"Send Telemetry"| MB[Monitoring Backend]
        MB -->|"Scrape/Export"| PROM[Prometheus]
        PROM --> GRAF[Grafana]
        MB -->|"Send to"| ASINS[Azure Monitor]
        MB -->|"Send to"| DD_METRICS
        MB -->|"Send to"| IC[ICINGA Monitor]
        MB -->|"Send to"| DD_MON[Datadog Monitoring]
    end

    %% Alerting
    subgraph Alert["Alerting"]
        MB -->|"Define Rules"| AR[Alert Rules]
        PROM -->|"Prometheus Alert"| PR_ALERT[Prometheus Alerting]
        GRAF -->|"Grafana Rule"| GRAF_ALERT[Grafana Alerting]
        IC -->|"Icinga Checks"| IC_ALERT[Icinga Alerting]
        DD_ALERTS[Datadog Alerting] -->|"Trigger"| ALRT1[Alert Manager]

        AR -->|"Trigger Alerts"| ALRT2[Alert Manager]

        %% Merge alert paths
        ALRT1 --> PD[PagerDuty]
        ALRT1 --> EMAIL[Email]
        ALRT1 --> SLACK[Slack]
        ALRT1 --> TEAMS[Teams]

        ALRT2 --> PD
        ALRT2 --> EMAIL
        ALRT2 --> SLACK
        ALRT2 --> TEAMS

        PR_ALERT --> ALRT2
        GRAF_ALERT --> ALRT2
        IC_ALERT --> ALRT2
    end

    %% Scaling
    subgraph Scale["Scaling"]
        MB -->|"Scale Decisions"| SCALER[Autoscaler]
        SCALER -->|"Kubernetes"| HPA[Horizontal Pod Autoscaler]
        SCALER -->|"Event-Driven"| KEDA[KEDA]
        SCALER -->|"Azure"| AZSCALE[Azure Autoscale]
        SCALER -->|"AWS"| AWS_AS[AWS Auto Scaling]
    end

    %% Secrets
    subgraph Sec["Secrets / Configuration"]
        VAULT[Vault / Key Vault]
        VAULT --> C
        VAULT --> LA
        VAULT --> LP
    end

    %% Toolboxes
    LA -->|"Tool"| FLB[Fluent Bit]
    LA -->|"Tool"| FLD[Fluentd]
    LP -->|"Tool"| LS[Logstash]
    LP -->|"Tool"| FB[Filebeat]

    %% Styling
    style App fill:#f0f8ff,stroke:#4682b4,stroke-width:1px
    style Telemetry fill:#e8f0fe,stroke:#1a73e8,stroke-width:2px
    style Log fill:#fff4e6,stroke:#ff8c00,stroke-width:1px
    style Mon fill:#e6ffe6,stroke:#2e8b57,stroke-width:1px
    style Alert fill:#ffe6e6,stroke:#b22222,stroke-width:1px
    style Scale fill:#f0e6ff,stroke:#8a2be2,stroke-width:1px
    style Sensitivity fill:#fffaf0,stroke:#b8860b,stroke-width:1px
    style Sec fill:#f2f2f2,stroke:#333,stroke-width:1px

    style ES fill:#ffe6ff,stroke:#d63384,stroke-width:1px
    style COS fill:#f5e6ff,stroke:#5a00b3,stroke-width:1px
    style APPINS fill:#e0e0ff,stroke:#0078d7,stroke-width:1px
    style FS fill:#f5f5f5,stroke:#555,stroke-width:1px
    style KAFKA fill:#e0ffff,stroke:#008b8b,stroke-width:1px
    style SPLUNK fill:#faf3dd,stroke:#000000,stroke-width:1px
    style DD_LOGS fill:#f0f0ff,stroke:#632ca6,stroke-width:2px
    style DD_METRICS fill:#f0f0ff,stroke:#632ca6,stroke-width:2px
    style DD_APM fill:#f0f0ff,stroke:#632ca6,stroke-width:2px
    style DD_MON fill:#f0f0ff,stroke:#632ca6,stroke-width:2px
    style DD_ALERTS fill:#f0f0ff,stroke:#632ca6,stroke-width:2px

    style GRAF fill:#e6f7ff,stroke:#ff9900,stroke-width:1px
    style PROM fill:#e6f7ff,stroke:#cc0000,stroke-width:1px
    style ASINS fill:#e6f7ff,stroke:#0078d7,stroke-width:1px
    style IC fill:#e6fff2,stroke:#006400,stroke-width:1px
    style IC_ALERT fill:#fff0f0,stroke:#006400,stroke-width:1px

    style PR_ALERT fill:#fff5e6,stroke:#ff8c00,stroke-width:1px
    style GRAF_ALERT fill:#fff5e6,stroke:#ff8c00,stroke-width:1px

    style PD fill:#ffe6e6,stroke:#ff0033,stroke-width:1px
    style EMAIL fill:#ffe6e6,stroke:#555,stroke-width:1px
    style SLACK fill:#ffe6e6,stroke:#4a154b,stroke-width:1px
    style TEAMS fill:#ddeeff,stroke:#0078d7,stroke-width:1px

    style FLB fill:#fff0f0,stroke:#cc5500,stroke-width:1px
    style FLD fill:#fff0f0,stroke:#cc5500,stroke-width:1px
    style LS fill:#fff0f0,stroke:#cc5500,stroke-width:1px
    style FB fill:#fff0f0,stroke:#cc5500,stroke-width:1px

    style VAULT fill:#fdf5e6,stroke:#6a5acd,stroke-width:2px
    style Agent fill:#f5f5f5,stroke:#632ca6,stroke-width:1px
